    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Hey.</string>
    <string name="onboarding_welcome_body">BlOCK stops you from doom-scrolling short videos.\nEvery. Single. Time.</string>
    <string name="onboarding_how_title">How it works</string>
    <string name="onboarding_how_body">When a reel or short appears, BlOCK kicks you out instantly. Then drops a block on your tower.</string>
    <string name="onboarding_privacy_title">Privacy promise</string>
    <string name="onboarding_privacy_body">Zero data leaves your phone. No analytics. No network. No accounts. Everything stays right here.</string>
    <string name="onboarding_accessibility_title">One thing I need</string>
    <string name="onboarding_accessibility_body">BlOCK uses Android\'s Accessibility Service to detect short videos. It never reads your messages, passwords, or anything else.</string>
    <string name="onboarding_battery_title">Keep me alive</string>
    <string name="onboarding_battery_body">Some phone manufacturers kill background apps aggressively. Exempt BlOCK from battery optimization so it stays on guard.</string>
    <string name="onboarding_restricted_title">Android 13+ sideload note</string>
    <string name="onboarding_restricted_body">If you installed via APK, go to Settings → Apps → BlOCK → three-dot menu → Allow restricted settings.</string>
    <string name="onboarding_done_title">Brick by brick.</string>
    <string name="onboarding_done_body">You\'re set. Every scroll you don\'t take builds your tower.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_enable">Enable</string>
    <string name="onboarding_done">Let\'s go</string>

